    "@trpc/client": "11.0.0-next-beta.289",
    "@trpc/react-query": "11.0.0-next-beta.289",
    "better-auth": "^1.3.11",
    "mantine-form-zod-resolver": "^1.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "superjson": "^2.2.1",
    "zod": "^3.0.0"
