    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.5",
    "drizzle-seed": "^0.3.1",
    "es-toolkit": "^1.42.0",
    "express": "^4.17.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.6",
    "pg": "^8.16.3",
    "superjson": "^2.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
