    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.19.12",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.4",
    "eslint": "^8.56.0",
    "rimraf": "^5.0.5",
    "supertest": "^7.1.4",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^3.2.4"
